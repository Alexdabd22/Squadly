{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost" ]
  },
  "Jwt": {
    "Issuer": "squadly-api",
    "Audience": "squadly-client",
    "ExpiryMinutes": "480"
  },
  "FileStorage": {
    "BasePath": "./uploads",
    "MaxFileSizeMb": "50"
  }
}
